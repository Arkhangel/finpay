# Скопировать в .env — двойное назначение: docker compose подставит все
# переменные ниже в compose.yaml через ${...} (это единственный ручной шаг,
# Б5.5, критерий самопроверки "docker compose up -d без ручных шагов"), а
# app/settings/__init__.py читает этот же файл напрямую для запуска скриптов
# на хосте без Docker (SettingsConfigDict(env_file=".env")) — раньше для
# этого был отдельный .config/local.toml, с Б6.4 он не используется.

# --- LLM-клиент (обязательно) ---
# AsyncOpenAI (стандартный SDK), но указывает на Groq через OPENAI__HOST —
# Groq даёт OpenAI-совместимый API. Ключ — Groq API key (console.groq.com,
# есть бесплатный тариф), не ключ от самого OpenAI. Без него app падает при
# старте: AsyncOpenAI(...) требует api_key ещё до первого запроса.
OPENAI__API_KEY=
OPENAI__HOST=https://api.groq.com/openai/v1
# openai/gpt-oss-120b — Groq депрекировал llama-3.1-8b-instant/llama-3.3-70b-versatile
# на free/developer-tier (2026-07-25), это их официальная рекомендованная замена.
OPENAI__MODEL=openai/gpt-oss-120b

# --- Внутренние секреты (можно сгенерировать самостоятельно, не внешние) ---
# Токен админ-ручек (app/admin) — сверяется с заголовком X-Admin-Token.
ADMIN_TOKEN=
# Общий секрет для канала backend -> bot (проактивные уведомления /notify).
BOT__INTERNAL_TOKEN=

# --- Telegram-бот (обязательно, если поднимаете сервис bot) ---
# Токен от @BotFather.
BOT__TOKEN=
# Telegram user_id (числа через запятую в []) с доступом к /stats, /users,
# /broadcast и к подтверждению HIL-действий агента (Б6.4).
BOT__ADMIN_IDS=[]

# --- Qdrant (М5.2) ---
# Общий секрет для Qdrant REST/gRPC API — прокидывается и в сам контейнер qdrant
# (QDRANT__SERVICE__API_KEY), и в приложение (QDRANT__API_KEY) как клиент.
QDRANT_API_KEY=

# Настройки клиента Qdrant в приложении (app/settings/qdrant.py).
# QDRANT__URL НЕ задаём здесь: compose.yaml хардкодит контейнеру
# http://qdrant:6333 напрямую (не через ${...} — не читает .env для этого
# ключа), а дефолт в app/settings/qdrant.py — http://localhost:6333, что и
# нужно для запуска скриптов на хосте. Если раскомментировать строку ниже —
# хостовые скрипты перестанут достучаться до Qdrant (qdrant:6333 резолвится
# только внутри docker-сети).
# QDRANT__URL=http://qdrant:6333
QDRANT__API_KEY=
QDRANT__COLLECTION=documents

# Размерность вектора эмбеддинг-модели (app/settings/embeddings.py) — должна
# совпадать с моделью из EMBEDDINGS__MODEL (768 для intfloat/multilingual-e5-base).
EMBEDDINGS__DIM=768

# --- CORS для локального REST API вне Docker (опционально) ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Chat-модуль на Postgres вне Docker (опционально, по умолчанию — json) ---
# CHAT__REPOSITORY=postgres
# CHAT__DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/finpay

# --- Б6.4: персистентный агент-граф (checkpointer + HIL) ---
# memory (только unit-тесты) | sqlite (дефолт, локальная разработка) |
# postgres (прод, docker-compose уже прописывает postgres напрямую).
# AGENT__CHECKPOINTER=sqlite
# AGENT__SQLITE_PATH=storage/agent_checkpoints.sqlite
# AGENT__POSTGRES_URI=postgresql://postgres:postgres@localhost:5433/finpay

# --- Безопасность (М3) ---
# Валидация входа + фильтрация вывода в /chat, /chat/stream (app/routers/chat.py).
# По умолчанию включено.
# SECURITY_ENABLED=true

# --- Второй слой модерации: OpenAI Moderation API (опционально, выключено по
# умолчанию) --- Настоящий OpenAI-ключ (platform.openai.com), НЕ Groq — сам
# эндпоинт /moderations проприетарный, на Groq его нет. Без этого ключа
# MODERATION__USE_OPENAI_API=true просто ничего не даёт (fail-open, см.
# app/moderation/service.py). Базовый keyword-слой работает всегда бесплатно
# и без этого ключа.
# MODERATION__USE_OPENAI_API=true
# MODERATION__OPENAI_API_KEY=

# --- Б5.6: RAGAS golden dataset (только scripts/generate_testset.py) ---
# Настоящий OpenAI-ключ (platform.openai.com), не Groq — TestsetGenerator
# делает много LLM-вызовов на knowledge graph, на free tier Groq это часы
# (см. docs/rag_evaluation.md). Судья метрик (EVAL__JUDGE_MODEL) и продакшен
# остаются на Groq — этот ключ нужен только для разовой генерации датасета.
EVAL__TESTSET_LLM_API_KEY=
EVAL__TESTSET_LLM_MODEL=gpt-5.4-mini

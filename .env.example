# Скопировать в .env — docker compose подставит все переменные ниже в
# compose.yaml через ${...}. Это единственный ручной шаг (Б5.5, критерий
# самопроверки "docker compose up -d без ручных шагов").

# --- LLM-клиент (обязательно) ---
# AsyncOpenAI (стандартный SDK), но указывает на Groq через OPENAI__HOST —
# Groq даёт OpenAI-совместимый API. Ключ — Groq API key (console.groq.com,
# есть бесплатный тариф), не ключ от самого OpenAI. Без него app падает при
# старте: AsyncOpenAI(...) требует api_key ещё до первого запроса.
OPENAI__API_KEY=
OPENAI__HOST=https://api.groq.com/openai/v1
# openai/gpt-oss-120b — Groq депрекировал llama-3.1-8b-instant/llama-3.3-70b-versatile
# на free/developer-tier (2026-07-25), это их официальная рекомендованная замена.
OPENAI__MODEL=openai/gpt-oss-120b

# --- Внутренние секреты (можно сгенерировать самостоятельно, не внешние) ---
# Токен админ-ручек (app/admin) — сверяется с заголовком X-Admin-Token.
ADMIN_TOKEN=
# Общий секрет для канала backend -> bot (проактивные уведомления /notify).
BOT__INTERNAL_TOKEN=

# --- Telegram-бот (обязательно, если поднимаете сервис bot) ---
# Токен от @BotFather.
BOT__TOKEN=

# --- Qdrant (М5.2) ---
# Общий секрет для Qdrant REST/gRPC API — прокидывается и в сам контейнер qdrant
# (QDRANT__SERVICE__API_KEY), и в приложение (QDRANT__API_KEY) как клиент.
QDRANT_API_KEY=

# Настройки клиента Qdrant в приложении (app/settings/qdrant.py).
QDRANT__URL=http://qdrant:6333
QDRANT__API_KEY=
QDRANT__COLLECTION=documents

# Размерность вектора эмбеддинг-модели (app/settings/embeddings.py) — должна
# совпадать с моделью из EMBEDDINGS__MODEL (768 для intfloat/multilingual-e5-base).
EMBEDDINGS__DIM=768

# --- Б5.6: RAGAS golden dataset (только scripts/generate_testset.py) ---
# Настоящий OpenAI-ключ (platform.openai.com), не Groq — TestsetGenerator
# делает много LLM-вызовов на knowledge graph, на free tier Groq это часы
# (см. docs/rag_evaluation.md). Судья метрик (EVAL__JUDGE_MODEL) и продакшен
# остаются на Groq — этот ключ нужен только для разовой генерации датасета.
EVAL__TESTSET_LLM_API_KEY=
EVAL__TESTSET_LLM_MODEL=gpt-5.4-mini
